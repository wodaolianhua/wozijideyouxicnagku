<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ============================================================================
    StrategyGame.Data.Tests —— 02 内容数据层单元测试
    ============================================================================
    测试组织：
      · ConfigValidatorTests —— 校验器能否抓到坏数据（重点：故意写坏必须被抓到）
      · JsonRoundTripTests   —— 加载→校验→再序列化，往返后数据完全一致
      · DataContractTests    —— 交付数据是否满足任务书的验收清单
    ============================================================================
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>StrategyGame.Data.Tests</AssemblyName>
    <RootNamespace>StrategyGame.Data.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StrategyGame.Data\StrategyGame.Data.csproj" />
    <ProjectReference Include="..\..\src\StrategyGame.Contracts\StrategyGame.Contracts.csproj" />
  </ItemGroup>

  <!-- 测试用的坏数据样本。故意写错，用来验证校验器能否抓到。 -->
  <ItemGroup>
    <None Include="fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
